#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-2.0-or-later

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

.PHONY: override_dh_auto_build override_dh_auto_install

override_dh_auto_build:
	# Optional Skindesigner support is detected via pkg-config if present.
	dh_auto_build -- WITH_SKINDESIGNER=auto

override_dh_auto_install:
	dh_auto_install --destdir=debian/vdr-plugin-image-next

%:
	dh $@ --with vdrplugin
